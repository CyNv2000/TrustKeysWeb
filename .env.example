# GEMINI_API_KEY: Optional for server-side AI features.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional - falls back to high-performance local persistent store if omitted)
# Supabase Project URL:
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Client-side Supabase keys (if direct client connection is used)
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Admin Portal Credentials (default admin login: admin@trustkeysrealty.com / trustkeys2026)
ADMIN_EMAIL="admin@trustkeysrealty.com"
ADMIN_PASSWORD="trustkeys2026"
SESSION_SECRET="trustkeys-super-secret-mumbai-realty-key-2026"
PORT=3000
